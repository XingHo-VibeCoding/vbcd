# ===== fun-asr 转写微服务（asr/）环境变量样例 =====
# 复制为 asr/.env 并填真实值（.env 不入库，已在 .gitignore 覆盖）
# PLAN.md §5 全量变量中，本期「精简四端点」范围内实际读取的就是下面这些。

# ---- 供应商与模型（必填 Key）----
DASHSCOPE_API_KEY=
# MAAS_API_KEY=                 # 与 DASHSCOPE_API_KEY 二选一，前者优先
MAAS_BASE_URL=https://maas.qianwenaiapi.com
ASR_MODEL=fun-asr-flash-2026-06-15

# ---- 服务自身与鉴权 ----
SERVICE_TOKEN=                  # 必填：/v1/* 的 Bearer token；不设则只绑 127.0.0.1 并在启动日志告警
ASR_BIND_HOST=0.0.0.0
ASR_PORT=8000

# ---- 切片与限流（A2 探针实测：单请求音频硬上限 300 秒，与体积无关；详见 PROBE.md）----
ASR_CHUNK_SECONDS=180           # 距硬上限 300s 留 40% 余量（wav 16k 单声道 ≈5.5MiB raw）
ASR_MAX_AUDIO_SECONDS=300       # 接口硬上限（探针实测：305s 起 400 空结果）；启动时校验 ASR_CHUNK_SECONDS ≤ 本值
ASR_MAX_B64_BYTES=10485760      # 仅是我方发送前护栏（不是接口限制：实测 300s wav 的 Base64 12.21MB 仍通过）
ASR_SILENCE_SEARCH_SECONDS=20   # 标称切片点 ±N 秒内找静音边界；找不到则定长切
ASR_CHUNK_CONCURRENCY=1         # 片间并发（默认串行）
ASR_GLOBAL_CONCURRENCY=3        # 全局 ASR 并发信号量
ASR_REQUEST_TIMEOUT=300         # 单次 ASR 请求超时（秒）
ASR_MAX_RETRIES=3               # 429/5xx/超时 → 指数退避重试次数

# ---- job 生命周期（临时媒体终态即删，只留小体积状态 JSON）----
JOBS_DIR=./.tmp-jobs            # 容器内为 /app/jobs（命名卷 asr-jobs）
JOB_TTL_SECONDS=1800            # 终态 job 的保留时间，到期由后台 GC 清掉
JOB_TIMEOUT_SECONDS=1800        # 单个 job 总时长上限
JOB_GC_INTERVAL_SECONDS=60      # GC 扫描间隔
CACHE_TTL_SECONDS=1800          # (source, options) → 结果 的短期缓存

# ---- 下载（yt-dlp）----
YTDLP_COOKIES_FILE=             # 会员/番剧需要，传 Netscape 格式 cookie 文件路径
YTDLP_PROXY=                    # 下载走代理时填
YTDLP_USER_AGENT=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- 上传（本期不做，占位）----
# MAX_UPLOAD_MB=200
