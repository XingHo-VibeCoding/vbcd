# ===== fun-asr 转写微服务（asr/）环境变量样例 =====
# 复制为 asr/.env 并填真实值（.env 不入库，已在 .gitignore 覆盖）
# PLAN.md §5 全量变量中，本期「精简四端点」范围内实际读取的就是下面这些。
#
# ⚠️ 写法约定：注释一律写在键的【上一行】，不要在值的同一行写 `# …`。
#    原因（2026-10-14 实测）：docker compose 的 env_file 只在「值非空」时才剥掉行内注释；
#    值留空时，整段 ` # …` 会被当成值本身 —— 例如 `SERVICE_TOKEN=   # 必填：…`
#    会让容器里的 token 变成那串中文注释（50 字符、非 ASCII），
#    调用方一发请求就是 401 AUTH_FAILED，而且非 ASCII 值根本塞不进 HTTP 头。
#    排查一行：docker exec <asr容器> python -c "import os;v=os.environ['SERVICE_TOKEN'];print(len(v),v.isascii())"
#    （长度对上、ascii=True 才算正常）

# ---- 供应商与模型（必填 Key）----
DASHSCOPE_API_KEY=
# 与 DASHSCOPE_API_KEY 二选一，前者优先
# MAAS_API_KEY=
MAAS_BASE_URL=https://maas.qianwenaiapi.com
ASR_MODEL=fun-asr-flash-2026-06-15

# ---- 服务自身与鉴权 ----
# 必填：/v1/* 的 Bearer token；不设则只绑 127.0.0.1 并在启动日志告警。
# 必须与 server/.env 的 ASR_SERVICE_TOKEN 完全一致，否则任务报「提交转写失败：缺少或错误的 Bearer Token」
SERVICE_TOKEN=
# 监听地址（app.py 直读；曾误写为 ASR_BIND_HOST，那个键代码不认）
ASR_HOST=0.0.0.0
ASR_PORT=8000

# ---- 切片与限流（A2 探针实测：单请求音频硬上限 300 秒，与体积无关；详见 PROBE.md）----
# 切片长度：距硬上限 300s 留 40% 余量（wav 16k 单声道 ≈5.5MiB raw）
ASR_CHUNK_SECONDS=180
# 接口硬上限（探针实测：305s 起 400 空结果）；启动时校验 ASR_CHUNK_SECONDS ≤ 本值
ASR_MAX_AUDIO_SECONDS=300
# 仅是我方发送前护栏（不是接口限制：实测 300s wav 的 Base64 12.21MB 仍通过）
ASR_MAX_B64_BYTES=10485760
# 静音边界搜索窗口：标称切片点 ±N 秒内找静音边界；找不到则定长切（字段名 asr_silence_window_seconds）
ASR_SILENCE_WINDOW_SECONDS=20
# 片间并发（默认串行）
ASR_CHUNK_CONCURRENCY=1
# 全局 ASR 并发信号量
ASR_GLOBAL_CONCURRENCY=3
# 单次 ASR 请求超时（秒）
ASR_REQUEST_TIMEOUT=300
# 429/5xx/超时 → 指数退避重试次数
ASR_MAX_RETRIES=3

# ---- job 生命周期（临时媒体终态即删，只留小体积状态 JSON）----
# 容器内为 /app/jobs（命名卷 asr-jobs）
JOBS_DIR=./.tmp-jobs
# 终态 job 的保留时间，到期由后台 GC 清掉
JOB_TTL_SECONDS=1800
# 单个 job 总时长上限
JOB_TIMEOUT_SECONDS=1800
# GC 扫描间隔目前硬编码 60s（jobs.gc_loop 的 interval 默认值），不可配；曾误列 JOB_GC_INTERVAL_SECONDS，设了无效
# (source, options) → 结果 的短期缓存
CACHE_TTL_SECONDS=1800

# ---- 下载（yt-dlp）----
# 单次下载超时（秒），字段名 download_timeout
DOWNLOAD_TIMEOUT=300
# 源媒体体积闸门，防超大文件塞爆磁盘（字段名 max_download_mb）
MAX_DOWNLOAD_MB=500
# 单文件 cookie（Netscape 格式）；只用一个平台时最省事
YTDLP_COOKIES_FILE=
# 多平台 cookie 目录：按 {platform}.txt 自动选（如 /app/secrets 里放 bilibili.txt / youtube.txt），优先于单文件
# 海外/机房部署必填其一：B 站与 YouTube 对机房 IP 一律 412 / bot 校验，无登录态基本无法下载
YTDLP_COOKIES_DIR=
# 下载走代理时填
YTDLP_PROXY=
YTDLP_USER_AGENT=
# ffmpeg / ffprobe 无需配置：audio.py 直接调同名命令走 PATH（曾误列 FFMPEG_PATH / FFPROBE_PATH，设了无效）

# ---- 上传（本期不做，占位）----
# MAX_UPLOAD_MB=200
