# 复制为 .env 并填入真实值（.env 不入库，.gitignore 已覆盖）

# ===== 上游 ASR（fun-asr-flash，多模态生成端点）=====
DASHSCOPE_API_KEY=                 # 必填（也可用别名 MAAS_API_KEY）
# MAAS_BASE_URL=https://maas.qianwenaiapi.com
# ASR_MODEL=fun-asr-flash-2026-06-15

# ===== 调用方鉴权 =====
# SERVICE_TOKEN=                 # 强烈建议设置；不设时服务只允许绑 127.0.0.1（容器内网不受限）

# ===== 切片与并发（一般不用改）=====
# ASR_CHUNK_SECONDS=180          # 片长目标；16k 单声道下 180s ≈ 7.7MB base64（<10MB 上限）
# ASR_MAX_B64_BYTES=10485760     # 上游 Base64 体积闸门
# ASR_SILENCE_WINDOW_SECONDS=20  # 静音边界搜索窗口（标称切点 ±N 秒）
# ASR_CHUNK_CONCURRENCY=1        # 片内并发（限流敏感，默认串行）
# ASR_GLOBAL_CONCURRENCY=3       # 全局同时在转的片数
# ASR_REQUEST_TIMEOUT=300        # 单次 ASR 请求超时（秒）
# ASR_MAX_RETRIES=3              # 429/5xx/超时 的退避重试次数

# ===== job 生命周期 =====
# JOBS_DIR=                    # 缺省 = asr/data/jobs（不依赖 cwd）；compose 里挂命名卷 /app/jobs
# JOB_TIMEOUT_SECONDS=1800
# JOB_TTL_SECONDS=1800           # 终态后 job JSON 保留时长

# ===== 下载 =====
# MAX_DOWNLOAD_MB=500            # 源媒体体积闸门
# YTDLP_COOKIES_FILE=            # B 站会员/番剧内容需要
# YTDLP_PROXY=
# YTDLP_USER_AGENT=

# ===== 缓存 =====
# CACHE_TTL_SECONDS=1800         # 同源结果缓存时长
