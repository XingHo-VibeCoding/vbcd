# 复制为 .env 并填入真实值（.env 不入库，已在 .gitignore）
PORT=3000
NODE_ENV=development

# 隐私模块（登录/鉴权）默认关闭：不设 AUTH_ENABLED 即完全公开、无需登录。
# AUTH_ENABLED=1              # 设 1 启用隐私模块（需登录）
# PASSWORD_HASH=              # 仅启用隐私时才需要：node scripts/hash-password.js "你的口令" 生成
# SESSION_TTL_HOURS=720       # 会话有效期（默认 720 = 30 天）

# 可选
# DATA_DIR=                  # 资料根目录；缺省 = 仓库根 data/（与 cwd 无关）
# INDEX_CACHE=0              # 设 0 强制每次重建索引（排错用）；缺省开启缓存

# ===== 知识库问答（RAG，F9）=====
# OPENAI_API_KEY=                # 必填（启用问答的前提）：OpenAI 兼容端点 key
# OPENAI_BASE_URL=https://api.openai.com/v1   # 可换 DashScope 兼容模式 / Ollama /v1 等
# LLM_MODEL=gpt-4o-mini          # 可换 deepseek-chat / qwen-plus / qwen2.5 等
# EMBED_MODEL=text-embedding-3-small          # 可换 text-embedding-v3 / nomic-embed-text 等
# EMBED_BASE_URL=                # 可空 = 与 OPENAI_BASE_URL 同端点；DeepSeek 这类无 embeddings 的端点需要单独配
# EMBED_API_KEY=                 # 可空 = 与 OPENAI_API_KEY 相同
# CHROMA_URL=http://localhost:8000            # Chroma 服务地址（自托管于 47.85.210.76 或本机）
# CHROMA_AUTH_TOKEN=             # 服务端开了 token 认证才需要（X-Chroma-Token）
# KB_TOP_K=3                     # 检索返回的段落数（1–10）
# KB_MAX_DISTANCE=               # 可空 = 不启用；设数值后距离大于它的命中会被丢弃（距离越小越像）
# LLM_TIMEOUT_MS=30000           # 模型调用超时（毫秒）。必须小于 Nginx 的 proxy_read_timeout(60s)，否则端点故障时用户看到的是 Nginx 504 而不是统一的中文错误
# LLM_MAX_RETRIES=1              # 失败重试次数（OpenAI SDK 默认 2，会拖长故障暴露时间）

# ===== 视频转写（F13，可选）=====
# ASR_SERVICE_URL=http://localhost:8000   # fun-asr 微服务地址；compose 内为 http://asr:8000
# ASR_SERVICE_TOKEN=                       # 与 asr/.env 的 SERVICE_TOKEN 一致
# ASR_HTTP_TIMEOUT_MS=15000                # 调 ASR 的单次请求超时
# ASR_POLL_INTERVAL_MS=5000                # 后台轮询器间隔
# ASR_JOB_MAX_WAIT_MINUTES=60              # job 超过此时长未完成判超时
# NOTE_LLM_TIMEOUT_MS=120000               # 转写笔记整理的模型超时（比问答慢，允许分钟级）
# LLM_TRANSCRIPT_MAX_CHARS=12000           # 喂给模型的转写文本上限（超长截头留尾）

# 暂未启用（当前实现不读取，先占位）
# LOG_LEVEL=info
# SESSION_SECRET=

# ===== 链接收敛（F14，归档页「收敛」）=====
# 不配下面这些也能跑（用默认值）；配 OPENAI_API_KEY 才有模型整理，否则资料只含原文节选 + 一行说明
# ORGANIZE_FETCH_TIMEOUT_MS=20000    # 抓单个网页的超时（毫秒）
# ORGANIZE_MAX_HTML_BYTES=2097152    # HTML 体积封顶（超过就截断，不爆内存）
# ORGANIZE_MIN_TEXT_CHARS=200        # 正文少于此字数即判提取失败（SPA/需登录页会遇到）
# ORGANIZE_EXCERPT_CHARS=8000        # 资料里「原文节选」的字数上限
# ORGANIZE_SWEEP_INTERVAL_MS=15000   # 兜底轮询间隔（收拾重试与进程重启留下的僵死任务）
# ORGANIZE_STALE_MS=240000           # doing 超过此时长未动算僵死；须大于 fetch+LLM 最坏耗时
# ORGANIZE_MAX_ATTEMPTS=3            # 僵死重试上限，超过判 failed 交给人工
# ORGANIZE_ALLOW_LOOPBACK=1        # 测试用：只放行回环地址（127.0.0.1/localhost/::1）；内网与云元数据地址仍恒拦

# ===== ima 云端知识库只读视图（F15，可选；档案页「云端」来源）=====
# 不配也能跑：页面显示「ima 未配置」空态，接口返回 503 IMA_NOT_CONFIGURED
# IMA_OPENAPI_CLIENTID=            # https://ima.qq.com/agent-interface 自建
# IMA_OPENAPI_APIKEY=              # 同上（Key 泄露等于把知识库交出去，勿入库勿截图）
# IMA_HTTP_TIMEOUT_MS=15000        # 单次 ima 调用超时
# IMA_CACHE_TTL_MS=60000           # 上游成功响应的进程内缓存时长；0=关闭（不落盘、重启即失）
# IMA_BASE_URL=https://ima.qq.com  # 缺省官方域名；仅供冒烟桩覆盖（SMOKE_FAKE_IMA_PORT）
