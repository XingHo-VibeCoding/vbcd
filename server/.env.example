# 复制为 .env 并填入真实值（.env 不入库，已在 .gitignore）
# 1a 骨架只用到 PORT / NODE_ENV；1b 登录会用到下面三行（由你本地生成后填入）
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# 1b 登录（已启用）：
#   SESSION_SECRET      会话签名随机串（任意长随机字符串）
#   PASSWORD_HASH       口令的 bcrypt 哈希：在本机执行 node scripts/hash-password.js "你的口令" 生成
#   SESSION_TTL_HOURS   会话有效期（默认 720 = 30 天）
# SESSION_SECRET=
# PASSWORD_HASH=
# SESSION_TTL_HOURS=720

# 1c 存储（到时再填）：
# DATA_DIR=
