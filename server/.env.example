# 复制为 .env 并填入真实值（.env 不入库，已在 .gitignore）
PORT=3000
NODE_ENV=development

# 登录（必填）：口令的 bcrypt 哈希，本机生成：
#   node scripts/hash-password.js "你的口令"
#   登录时输入的是**明文口令**，不是这串哈希
PASSWORD_HASH=

# 可选
# SESSION_TTL_HOURS=720      # 会话有效期（默认 720 = 30 天）
# DATA_DIR=                  # 资料根目录；缺省 = 仓库根 data/（与 cwd 无关）
# INDEX_CACHE=0              # 设 0 强制每次重建索引（排错用）；缺省开启缓存

# 暂未启用（当前实现不读取，先占位）
# LOG_LEVEL=info
# SESSION_SECRET=
